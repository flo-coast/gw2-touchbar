        box.append(Gtk.ScrolledWindow(child=self.keys_box, vexpand=True))
        box.append(self.buttons([("Add key", self.add_key)]))
        self.fill_keys()
        return box

    def fill_keys(self):
        while (c := self.keys_box.get_first_child()):
            self.keys_box.remove(c)
        for i, k in enumerate(self.cfg["keys"]):
            row = Gtk.Box(spacing=8)
            name = Gtk.Entry(text=k["label"], width_chars=12)
            keys = Gtk.Entry(text=" + ".join(k["keys"]), width_chars=30)
            for e in (name, keys):
                e.connect("activate", lambda _e, i=i, n=name, ks=keys: self.set_key(i, n, ks))
                leave = Gtk.EventControllerFocus()   # also when you click elsewhere, not only on Enter
                leave.connect("leave", lambda *_a, i=i, n=name, ks=keys: self.set_key(i, n, ks))
                e.add_controller(leave)
            rm = Gtk.Button(label="Remove")
            rm.connect("clicked", lambda _b, i=i: self.remove_key(i))
            for w in (label("Label"), name, label("Keys"), keys, rm):
                row.append(w)
            self.keys_box.append(row)

    def set_key(self, i, name, keys):
        ks = [x.strip() for x in keys.get_text().replace(",", "+").split("+") if x.strip()]
        new = {"label": name.get_text().strip() or "?", "keys": ks}
        if ks and i < len(self.cfg["keys"]) and self.cfg["keys"][i] != new:     # the row may be gone already
            self.cfg["keys"][i] = new
            self.changed()

    def add_key(self, *_):
        self.cfg["keys"].append({"label": "New", "keys": ["F1"]})
        self.fill_keys()
        self.changed()

    def remove_key(self, i):
        del self.cfg["keys"][i]
        self.fill_keys()
        self.changed()

    # ------------------------------------------------------------------ pages
    def fill_pages(self):
        self.busy = True
        while (c := self.page_list.get_first_child()):
            self.page_list.remove(c)
        for pg in self.cfg["pages"]:
            self.page_list.append(label(f"{pg['name']}  ·  {len(pg['panels'])} panels"))
        self.page_list.select_row(self.page_list.get_row_at_index(self.page))
        self.page_name.set_text(self.cfg["pages"][self.page]["name"])
        self.busy = False
        self.fill_panels()

    def on_page_selected(self, _lb, row):
        if self.busy or row is None:
            return
        self.page, self.sel = row.get_index(), None
        self.page_name.set_text(self.cfg["pages"][self.page]["name"])
        self.fill_panels()
        self.render()

    def on_page_name(self, entry):
        name = entry.get_text().strip()
        if name and name != self.cfg["pages"][self.page]["name"]:
            self.cfg["pages"][self.page]["name"] = name
            self.fill_pages()
            self.changed()

    def add_page(self, *_):
        self.cfg["pages"].insert(self.page + 1, {"name": f"Page {len(self.cfg['pages']) + 1}",
                                                 "panels": [config.panel({"type": "clock"})]})
        self.page, self.sel = self.page + 1, None
        self.fill_pages()
        self.changed()

    def move_page(self, d):
        j = self.page + d
        if 0 <= j < len(self.cfg["pages"]):
            p = self.cfg["pages"]
            p[self.page], p[j] = p[j], p[self.page]
            self.page = j
            self.fill_pages()
            self.changed()

    def delete_page(self, *_):
        if len(self.cfg["pages"]) > 1:
            del self.cfg["pages"][self.page]
            self.page, self.sel = max(0, self.page - 1), None
            self.fill_pages()
            self.changed()

    # ------------------------------------------------------------------ panels
    @property
    def panels(self):
        return self.cfg["pages"][self.page]["panels"]

    def fill_panels(self):
        self.busy = True
        while (c := self.panel_list.get_first_child()):
            self.panel_list.remove(c)
        for p in self.panels:
            c = config.CATALOG[p["type"]]
            w = f"{p['width']} px" if p["width"] else "fills"
            extra = [w] + ([p["style"]] if c.get("num") else []) + (["own colour"] if p["color"] else [])
            if p["type"] == "sensors":
                extra.insert(0, ", ".join(config.SHORT[k] for k in p["items"]) or "nothing picked")
            elif p["type"] == "battery":
                extra.insert(0, p["device_name"] or p["device"] or "all devices")
            self.panel_list.append(label(f"{c['title']}  ·  {' · '.join(extra)}"))
        if self.sel is not None and self.sel < len(self.panels):
            self.panel_list.select_row(self.panel_list.get_row_at_index(self.sel))
        else:
            self.sel = None
        used = sum(p["width"] for p in self.panels) + 6 * max(0, len(self.panels) - 1) + 16
        fills = sum(1 for p in self.panels if not p["width"])
        over = used > config.BAR_WIDTH
        self.width_label.set_markup(
            f"{'<span foreground=\"#e05040\">' if over else ''}{used} of {config.BAR_WIDTH} px used"
            f"{' (too wide, the last panels are cut off)</span>' if over else ''}"
            + (f" · {fills} panel{'s' if fills > 1 else ''} share the rest" if fills and not over else ""))
        self.busy = False
        self.fill_props()

    def on_panel_selected(self, _lb, row):
        if self.busy:
            return
        self.sel = row.get_index() if row else None
        self.fill_props()

    def fill_props(self):
        self.busy = True
        p = self.panels[self.sel] if self.sel is not None else None
        self.props.set_sensitive(p is not None)
        if p:
            c = config.CATALOG[p["type"]]
            self.props_title.set_text(c["title"])
            self.p_width.set_value(p["width"])
            self.p_size.set_value(p["size"])
            self.p_style.set_selected(config.STYLES.index(p["style"]))
            self.p_style.set_sensitive(bool(c.get("num")))
            self.p_sub.set_active(p["sub"])
            self.p_color_on.set_active(bool(p["color"]))
            rgba = Gdk.RGBA()
            rgba.parse(p["color"] or "#333333")
            self.p_color.set_rgba(rgba)
            for name, on in (("Values", p["type"] == "sensors"), ("Device", p["type"] == "battery")):
                for w in self.prop_rows[name]:
                    w.set_visible(on)
            if p["type"] == "sensors":
                for k, cb in self.p_item_checks.items():
                    cb.set_active(k in p["items"])
                self.limit_items()
            if p["type"] == "battery":
                self.fill_devices(p)
            self.props_hint.set_text(
                f"Up to {config.MAX_ITEMS} values side by side. Make the panel wider if they get cut off."
                if p["type"] == "sensors" else
                "All devices side by side, or pick one and add more battery panels for the others."
                if p["type"] == "battery" else
                "The colour is the panel's background (and its graph line). Panels that change colour by "
                "themselves, like combat or a boss that's up, keep their own." if not c.get("num") else
                "Graphs keep the last 30 s to 5 min, see Settings.")
        else:
            self.props_title.set_text("Select a panel (or click it in the preview)")
            for name in ("Values", "Device"):
                for w in self.prop_rows[name]:
                    w.set_visible(False)
        self.busy = False

    def on_items(self, *_):
        if self.busy or self.sel is None:
            return
        p = self.panels[self.sel]
        on = [k for k in config.NUMS if self.p_item_checks[k].get_active()]
        p["items"] = [k for k in p.get("items", []) if k in on] + [k for k in on if k not in p.get("items", [])]
        p["width"] = max(110, 105 * len(p["items"]) + 10)       # room for each value, adjust it after
        self.busy = True
        self.p_width.set_value(p["width"])
        self.busy = False
        self.limit_items()
        self.fill_panels()
        self.changed()

    def limit_items(self):
        full = sum(cb.get_active() for cb in self.p_item_checks.values()) >= config.MAX_ITEMS
        for cb in self.p_item_checks.values():
            cb.set_sensitive(cb.get_active() or not full)

    def fill_devices(self, p):
        """The device list: every device with a battery right now, plus the panel's own if it's away."""
        devs = [d for d in online.Online.batteries(None) if "id" in d]
        self.device_choices = [("", "All devices")] + [(d["id"], f"{d['name']} ({d['pct']:.0f} %)") for d in devs]
        if p["device"] and p["device"] not in [i for i, _ in self.device_choices]:
            self.device_choices.append((p["device"], f"{p['device_name'] or p['device']} (not connected)"))
        self.p_device.set_model(Gtk.StringList.new([n for _, n in self.device_choices]))
        self.p_device.set_selected([i for i, _ in self.device_choices].index(p["device"]))
        self.device_names = {d["id"]: d["name"] for d in devs}

    def on_device(self, dd, _p):
        if self.busy or self.sel is None or self.panels[self.sel]["type"] != "battery":
            return
        i = dd.get_selected()
        if i >= len(self.device_choices):
            return
        p = self.panels[self.sel]
        p["device"] = self.device_choices[i][0]
        p["device_name"] = self.device_names.get(p["device"], p.get("device_name", "")) if p["device"] else ""
        self.fill_panels()
        self.changed()

    def set_prop(self, key, value):
        if self.busy or self.sel is None:
            return
        self.panels[self.sel][key] = value
        self.fill_panels()
        self.changed()

    def on_size(self, scale):
        v = int(scale.get_value())
        if 0 < v < config.FONT_SIZES[0]:          # the gap between auto and the smallest size
            v = config.FONT_SIZES[0]
        self.set_prop("size", v)

    def on_color(self, *_):
        if self.busy:
            return
        self.set_prop("color", hex_of(self.p_color.get_rgba()) if self.p_color_on.get_active() else "")

    def add_panel(self, *_):
        t = self.catalog[self.add_choice.get_selected()]
        at = (self.sel + 1) if self.sel is not None else len(self.panels)
        self.panels.insert(at, config.panel({"type": t}))
        self.sel = at
        self.fill_pages()
        self.changed()

    def move_panel(self, d):
        if self.sel is None:
            return
        j = self.sel + d
        if 0 <= j < len(self.panels):
            self.panels[self.sel], self.panels[j] = self.panels[j], self.panels[self.sel]
            self.sel = j
            self.fill_panels()
            self.changed()

    def dup_panel(self, *_):
        if self.sel is not None:
            self.panels.insert(self.sel + 1, copy.deepcopy(self.panels[self.sel]))
            self.sel += 1
            self.fill_pages()
            self.changed()

    def remove_panel(self, *_):
        if self.sel is not None:
            del self.panels[self.sel]
            self.sel = None
            self.fill_pages()
            self.changed()

    def on_preview_click(self, _g, _n, x, _y):
        pw = self.preview.get_width()
        if not pw or not self.rects:
            return
        scale = min(pw / config.BAR_WIDTH, self.preview.get_height() / 60)
        off = (pw - config.BAR_WIDTH * scale) / 2
        bx = (x - off) / scale
        for i, (x0, x1) in enumerate(self.rects):
            if x0 <= bx <= x1:
                self.sel = i
                self.fill_panels()
                return

    # ------------------------------------------------------------------ on/off
    def on_power(self, sw, _p):
        if self.power_busy or SELFTEST:
            return
        if sw.get_active():
            ok, msg = systemctl("start", FEED, user=True)
            ok2, msg2 = systemctl("start", "--no-block", BAR) if ok else (False, "")
            if not (ok and ok2):
                self.power_error = f"could not switch on: {msg or msg2}"
                systemctl("stop", "--no-block", FEED, user=True)
                self.power_busy = True
                sw.set_active(False)
                self.power_busy = False
            else:
                self.power_error = ""
        else:
            self.power_off()
        self.update_power()

    def power_off(self):
        """Bar first (it hands the Touch Bar back to tiny-dfr), then the feed."""
        if SELFTEST:
            return
        systemctl("stop", "--no-block", BAR)
        systemctl("stop", "--no-block", FEED, user=True)

    def on_close(self, *_):
        if self.save_id:                       # a change from the last 400 ms is still waiting
            GLib.source_remove(self.save_id)
            self.save()
        self.power_off()
        return False                           # let the window close

    def update_power(self):
        on = bar_active()
        if on != self.power.get_active():
            self.power_busy = True
            self.power.set_active(on)
            self.power_busy = False
        if SELFTEST:
            text = "self-test, the switch does nothing"
        elif self.power_error and not on:
            text = self.power_error
        elif not on:
            text = "off, the Touch Bar shows the F-keys"
        elif gw2_pids():
            text = "on, GW2 has the Touch Bar. Closing this app switches it off"
        else:
            text = "on, waits for GW2. Closing this app switches it off"
        self.power_label.set_text(text)

    def set_login(self, on):
        if self.busy or SELFTEST:
            return
        if on:
            os.makedirs(os.path.dirname(AUTOSTART), exist_ok=True)
            with open(AUTOSTART, "w") as f:
                f.write("[Desktop Entry]\nType=Application\nName=GW2 Touch Bar\n"
                        f"Exec={os.path.realpath(sys.argv[0])}\nIcon=input-touchpad\n"
                        "Comment=Settings and on/off switch for the GW2 Touch Bar\n")
        else:
            try:
                os.unlink(AUTOSTART)
            except FileNotFoundError:
                pass

    # ------------------------------------------------------------------ settings
    def set_setting(self, key, value):
        if self.busy:
            return
        self.cfg["settings"][key] = value
        self.changed()

    def changed(self):
        self.render()
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(400, self.save)

    def save(self):
        self.save_id = None
        config.save(self.cfg)
        self.cfg = config.load()
        return False

    # ------------------------------------------------------------------ preview
    def render(self):
        live = live_state()
        self.source_label.set_text("preview with live data from GW2" if live else
                                   "preview with sample data (GW2 isn't running)")
        cfg = config.normalize(self.cfg)
        img = barbuild.render(cfg, self.page, live or sample_state())
        self.rects = self.panel_rects(cfg)
        img.flush()
        data = GLib.Bytes.new(bytes(img.get_data()))
        tex = Gdk.MemoryTexture.new(img.get_width(), img.get_height(), Gdk.MemoryFormat.B8G8R8A8_PREMULTIPLIED,
                                    data, img.get_stride())
        self.preview.set_paintable(tex)

    def panel_rects(self, cfg):
        """x ranges of the page's panels, the way the engine lays them out (for clicks on the preview)."""
        from macarchy_touchbar.layout import distribute
        panels = cfg["pages"][self.page]["panels"]
        rects = distribute([p["width"] for p in panels], [0 if p["width"] else 1 for p in panels],
                           config.BAR_WIDTH - (14 * len(cfg["pages"]) + 10 + 6
                                               if cfg["settings"]["page_dots"] and len(cfg["pages"]) > 1 else 0))
        return [(r.x, r.x + r.w) for r in rects]

    def tick(self):
        if live_state():
            self.render()
        self.update_power()
        return True


class App(Gtk.Application):
    def __init__(self):
        # one window normally, but self-test runs must not hand over to an instance that is still closing
        flags = Gio.ApplicationFlags.NON_UNIQUE if os.environ.get("GW2TB_SHOT") else Gio.ApplicationFlags.DEFAULT_FLAGS
        super().__init__(application_id="de.flo.Gw2TouchbarSettings", flags=flags)

    def do_activate(self):
        win = self.get_active_window() or Settings(self)
        win.present()
        if os.environ.get("GW2TB_SHOT"):              # self-test: photograph the window, then quit
            GLib.timeout_add(1500, self.shot, win, os.environ["GW2TB_SHOT"])

    def shot(self, win, path, tries=30):
        """Self-test photo. A busy machine may not have drawn the window yet: try again for a few seconds."""
        node = None
        if win.get_mapped() and win.get_width() > 0:
            snap = Gtk.Snapshot()
            Gtk.WidgetPaintable.new(win).snapshot(snap, win.get_width(), win.get_height())
            node = snap.to_node()
        if node:
            win.get_native().get_renderer().render_texture(node, None).save_to_png(path)
        elif tries:
            GLib.timeout_add(300, self.shot, win, path, tries - 1)
            return False
        else:
            print("shot: the window never got drawn", file=sys.stderr)
        self.quit()
        return False


if __name__ == "__main__":
    App().run(sys.argv[:1])
