    def on_tp(self, entry):
        watch, bad = [], []
        for part in (p.strip() for p in entry.get_text().split(",") if p.strip()):
            item, _, target = part.partition("@")
            iid, copper = online.chat_link_item(item), online.parse_coins(target) if target else 0
            if iid is None or copper is None:
                bad.append(part)
            else:
                watch.append({"id": iid, "target": copper})
        self.o_status.set_text(f"not understood: {', '.join(bad)}" if bad else f"{len(watch)} items on the watchlist")
        if not bad:
            self.set_setting("tp_watch", watch)

