def live_state():
    """The feed's state when GW2 runs (fresh state.json), else None."""
    src = state.Source()
    saved, state.override = state.override, None
    try:
        s = src.get()
    finally:
        state.override = saved
    return s or None


def hex_of(rgba):
    return "#{:02x}{:02x}{:02x}".format(*(round(c * 255) for c in (rgba.red, rgba.green, rgba.blue)))


def label(text, css=None, xalign=0.0):
    lb = Gtk.Label(label=text, xalign=xalign)
    if css:
        lb.add_css_class(css)
    return lb


class Settings(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="GW2 Touch Bar")
        self.set_default_size(1500, 820)
        self.cfg = config.load()
        self.page, self.sel = 0, None          # selected page, selected panel index
        self.busy = False                      # True while widgets are filled from cfg (no save loops)
        self.save_id = None

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        for m in ("top", "bottom", "start", "end"):
            getattr(root, f"set_margin_{m}")(14)
        self.set_child(root)

        # the on/off switch: the bar runs only while it's on and this app is open
        power = Gtk.Box(spacing=12)
        power.append(label("Touch Bar for GW2", "heading"))
        self.power = Gtk.Switch(valign=Gtk.Align.CENTER, sensitive=not SELFTEST)
        self.power.connect("notify::active", self.on_power)
        power.append(self.power)
        self.power_label = label("", "dim-label")
        power.append(self.power_label)
        root.append(power)
        self.power_busy = False                # True while tick() mirrors the service state into the switch
        self.power_error = ""
        self.connect("close-request", self.on_close)

        # preview: the real renderer, scaled to the window; click a panel to select it
        self.preview = Gtk.Picture(can_shrink=True, content_fit=Gtk.ContentFit.CONTAIN)
        self.preview.set_size_request(-1, 70)
        click = Gtk.GestureClick()
        click.connect("pressed", self.on_preview_click)
        self.preview.add_controller(click)
        frame = Gtk.Frame(child=self.preview)
        root.append(frame)
        info = Gtk.Box(spacing=12)
        self.source_label = label("", "dim-label")
        self.width_label = label("", xalign=1.0)
        self.width_label.set_hexpand(True)
        info.append(self.source_label)
        info.append(self.width_label)
        root.append(info)

        stack = Gtk.Stack()
        switcher = Gtk.StackSwitcher(stack=stack, halign=Gtk.Align.CENTER)
        root.append(switcher)
        root.append(stack)
        stack.add_titled(self.build_layout_tab(), "layout", "Pages and panels")
        stack.add_titled(self.build_settings_tab(), "settings", "Settings")
        stack.add_titled(self.build_online_tab(), "online", "Account and online")
        stack.add_titled(self.build_keys_tab(), "keys", "Keys group")
        stack.set_vexpand(True)
        if os.environ.get("GW2TB_TAB"):            # self-test: open on this tab
            stack.set_visible_child_name(os.environ["GW2TB_TAB"])
        if os.environ.get("GW2TB_PANEL"):          # self-test: select panel "page,index"
            self.page, self.sel = (int(x) for x in os.environ["GW2TB_PANEL"].split(","))

        self.fill_pages()
        self.fill_props()
        self.render()
        if not SELFTEST and self.cfg["settings"]["start_on_open"] and not bar_active():
            self.power.set_active(True)        # on_power starts it
        self.update_power()
        GLib.timeout_add_seconds(1, self.tick)

