    def build_keys_tab(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(label("The buttons the Keys panel opens. Keys are evdev names without KEY_, "
                         "for example M, F1, LeftShift. Several keys are pressed together.",
